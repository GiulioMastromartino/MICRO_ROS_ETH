<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <OutputType>Library</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Antmicro.Renode.Plugins.JSN_SR04T</RootNamespace>
    <AssemblyName>JSN_SR04T_Plugin</AssemblyName>
    <Version>1.0.0</Version>
    <Authors>Test_Board_Sensore</Authors>
    <Description>JSN-SR04T Ultrasonic Sensor Plugin for Renode</Description>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Antmicro.Renode">
      <HintPath>../../../../renode/output/bin/Release/Antmicro.Renode.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Antmicro.Renode.Core">
      <HintPath>../../../../renode/output/bin/Release/Antmicro.Renode.Core.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Antmicro.Renode.Peripherals">
      <HintPath>../../../../renode/output/bin/Release/Antmicro.Renode.Peripherals.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Antmicro.Renode.Debugging">
      <HintPath>../../../../renode/output/bin/Release/Antmicro.Renode.Debugging.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Antmicro.Renode.Extensions">
      <HintPath>../../../../renode/output/bin/Release/Antmicro.Renode.Extensions.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Infrastructure">
      <HintPath>../../../../renode/output/bin/Release/Infrastructure.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Debug'">
    <DebugType>full</DebugType>
    <DebugSymbols>true</DebugSymbols>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <Optimize>true</Optimize>
    <DebugType>pdbonly</DebugType>
  </PropertyGroup>

</Project>
