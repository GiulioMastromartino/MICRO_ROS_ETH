 512:../../Drivers/STM32H7xx_HAL_Driver/Src/stm32h7xx_hal_i2c.c ****         (++) Clock Timing
 513:../../Drivers/STM32H7xx_HAL_Driver/Src/stm32h7xx_hal_i2c.c ****         (++) Own Address 1
