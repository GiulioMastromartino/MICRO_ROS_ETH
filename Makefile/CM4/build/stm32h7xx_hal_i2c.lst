 599:../../Drivers/STM32H7xx_HAL_Driver/Src/stm32h7xx_hal_i2c.c ****   {
 600:../../Drivers/STM32H7xx_HAL_Driver/Src/stm32h7xx_hal_i2c.c ****     hi2c->Instance->OAR1 = (I2C_OAR1_OA1EN | hi2c->Init.OwnAddress1);
