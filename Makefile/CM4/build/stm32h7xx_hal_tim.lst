6945:../../Drivers/STM32H7xx_HAL_Driver/Src/stm32h7xx_hal_tim.c ****     tmpcr1 |= Structure->CounterMode;
6946:../../Drivers/STM32H7xx_HAL_Driver/Src/stm32h7xx_hal_tim.c ****   }
