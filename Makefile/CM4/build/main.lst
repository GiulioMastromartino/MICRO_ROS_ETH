 103:../../CM4/Core/Src/main.c ****     /* PHASE 2: Raw ECHO read — no trigger sent                           */
 104:../../CM4/Core/Src/main.c ****     /* GREEN = PD0 reads HIGH                                             */
 105:../../CM4/Core/Src/main.c ****     /* RED   = PD0 reads LOW  (expected with PULLDOWN and no signal)      */
 106:../../CM4/Core/Src/main.c ****     /* ================================================================== */
 107:../../CM4/Core/Src/main.c **** 
 108:../../CM4/Core/Src/main.c ****     /* 2× slow red = entering phase 2 */
 109:../../CM4/Core/Src/main.c ****     for (int j = 0; j < 2; j++) {
 110:../../CM4/Core/Src/main.c ****         LED_RED_ON(); HAL_Delay(500U);
 111:../../CM4/Core/Src/main.c ****         LED_RED_OFF(); HAL_Delay(500U);
 112:../../CM4/Core/Src/main.c ****     }
 113:../../CM4/Core/Src/main.c ****     HAL_Delay(500U);
 114:../../CM4/Core/Src/main.c **** 
 115:../../CM4/Core/Src/main.c ****     uint32_t phase2_start = HAL_GetTick();
 116:../../CM4/Core/Src/main.c ****     while (HAL_GetTick() - phase2_start < 5000U) {
 117:../../CM4/Core/Src/main.c ****         if (HAL_GPIO_ReadPin(GPIOD, GPIO_PIN_0) == GPIO_PIN_SET) {
 118:../../CM4/Core/Src/main.c ****             LED_GREEN_ON(); LED_RED_OFF();
 119:../../CM4/Core/Src/main.c ****         } else {
 120:../../CM4/Core/Src/main.c ****             LED_GREEN_OFF(); LED_RED_ON();
 121:../../CM4/Core/Src/main.c ****         }
 122:../../CM4/Core/Src/main.c ****         HAL_Delay(50U);
 123:../../CM4/Core/Src/main.c ****     }
 124:../../CM4/Core/Src/main.c ****     LED_ALL_OFF();
 125:../../CM4/Core/Src/main.c ****     HAL_Delay(5000U);
