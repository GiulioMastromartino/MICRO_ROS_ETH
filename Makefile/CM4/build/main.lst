  27:../../CM4/Core/Src/main.c **** #define LED_GREEN_OFF()  (GPIOB->BSRR = (1U << 16))
  28:../../CM4/Core/Src/main.c **** #define LED_RED_ON()     (GPIOB->BSRR = (1U << 14))
  29:../../CM4/Core/Src/main.c **** #define LED_RED_OFF()    (GPIOB->BSRR = (1U << 30))
  30:../../CM4/Core/Src/main.c **** #define LED_ALL_OFF()    do { LED_GREEN_OFF(); LED_RED_OFF(); } while(0)
