  44:../../CM4/Core/Src/main.c ****     GPIOB->MODER &= ~(3U << 0);   GPIOB->MODER |= (1U << 0);   /* PB0  out */
  45:../../CM4/Core/Src/main.c ****     GPIOB->MODER &= ~(3U << 28);  GPIOB->MODER |= (1U << 28);  /* PB14 out */
  46:../../CM4/Core/Src/main.c **** 
  47:../../CM4/Core/Src/main.c ****     /* Quick alive blink */
