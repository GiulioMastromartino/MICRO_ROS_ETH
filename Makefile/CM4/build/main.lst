  82:../../CM4/Core/Src/main.c ****     /* PHASE 1: TRIG toggle — probe PD1 with multimeter                   */
  83:../../CM4/Core/Src/main.c ****     /* Expected: ~3.3V / 0V alternating every 500ms                       */
  84:../../CM4/Core/Src/main.c ****     /* Failure:  stuck at 0V → GPIOD clock or MX_GPIO_Init broken         */
  85:../../CM4/Core/Src/main.c ****     /* ================================================================== */
  86:../../CM4/Core/Src/main.c **** 
  87:../../CM4/Core/Src/main.c ****     /* 1× slow red = entering phase 1 */
  88:../../CM4/Core/Src/main.c ****     LED_RED_ON(); HAL_Delay(1000U); LED_RED_OFF(); HAL_Delay(500U);
  89:../../CM4/Core/Src/main.c **** 
  90:../../CM4/Core/Src/main.c ****     uint32_t phase1_start = HAL_GetTick();
ARM GAS  /var/folders/2r/mdtt8xvd351gdc398t28_m2m0000gn/T//ccImzACi.s 			page 3


  91:../../CM4/Core/Src/main.c ****     while (HAL_GetTick() - phase1_start < 5000U) {
  92:../../CM4/Core/Src/main.c ****         HAL_GPIO_WritePin(GPIOD, GPIO_PIN_1, GPIO_PIN_SET);
  93:../../CM4/Core/Src/main.c ****         LED_GREEN_ON();
