 205:../../CM4/Core/Src/main.c ****             LED_GREEN_ON(); HAL_Delay(150U);
 206:../../CM4/Core/Src/main.c ****             LED_GREEN_OFF(); HAL_Delay(150U);
 207:../../CM4/Core/Src/main.c ****         }
 208:../../CM4/Core/Src/main.c ****         HAL_Delay(1500U);   /* pause between readings */
 209:../../CM4/Core/Src/main.c **** 
 210:../../CM4/Core/Src/main.c ****         /* Retrigger for fresh distance */
 211:../../CM4/Core/Src/main.c ****         HAL_GPIO_WritePin(GPIOD, GPIO_PIN_1, GPIO_PIN_RESET);
