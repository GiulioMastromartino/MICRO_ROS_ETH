 223:../../CM4/Core/Src/main.c ****         }
 224:../../CM4/Core/Src/main.c ****         if (HAL_GPIO_ReadPin(GPIOD, GPIO_PIN_0) == GPIO_PIN_SET) {
 225:../../CM4/Core/Src/main.c ****             uint32_t es = __HAL_TIM_GET_COUNTER(&htim2);
 226:../../CM4/Core/Src/main.c ****             while (HAL_GPIO_ReadPin(GPIOD, GPIO_PIN_0) == GPIO_PIN_SET) {
 227:../../CM4/Core/Src/main.c ****                 if ((uint32_t)(__HAL_TIM_GET_COUNTER(&htim2) - es)
 228:../../CM4/Core/Src/main.c ****                         > ECHO_PULSE_TIMEOUT_US) { break; }
 229:../../CM4/Core/Src/main.c ****             }
 230:../../CM4/Core/Src/main.c ****             echo_time = (uint32_t)(__HAL_TIM_GET_COUNTER(&htim2) - es);
