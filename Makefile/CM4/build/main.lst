  63:../../CM4/Core/Src/main.c ****     uint32_t apb1pre = (RCC->D2CFGR & RCC_D2CFGR_D2PPRE1_Msk)
  64:../../CM4/Core/Src/main.c ****                         >> RCC_D2CFGR_D2PPRE1_Pos;
  65:../../CM4/Core/Src/main.c ****     uint32_t tim2clk = (apb1pre >= 0x04U) ? (pclk1 * 2U) : pclk1;
  66:../../CM4/Core/Src/main.c ****     uint32_t psc     = (tim2clk / TIMER_TARGET_HZ);
  67:../../CM4/Core/Src/main.c ****     if (psc > 0U) { psc -= 1U; }
  68:../../CM4/Core/Src/main.c ****     __HAL_TIM_SET_PRESCALER(&htim2, psc);
