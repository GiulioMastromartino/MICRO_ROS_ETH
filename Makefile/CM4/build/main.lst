 128:../../CM4/Core/Src/main.c ****     /* ================================================================== */
 129:../../CM4/Core/Src/main.c ****     /* PHASE 3: Full trigger → echo attempt, 10 tries                    */
 130:../../CM4/Core/Src/main.c ****     /* GREEN blink = echo received                                        */
 131:../../CM4/Core/Src/main.c ****     /* RED blink   = timeout                                              */
 132:../../CM4/Core/Src/main.c ****     /* ================================================================== */
 133:../../CM4/Core/Src/main.c **** 
 134:../../CM4/Core/Src/main.c ****     /* 3× slow red = entering phase 3 */
 135:../../CM4/Core/Src/main.c ****     for (int j = 0; j < 3; j++) {
 136:../../CM4/Core/Src/main.c ****         LED_RED_ON(); HAL_Delay(500U);
 137:../../CM4/Core/Src/main.c ****         LED_RED_OFF(); HAL_Delay(500U);
 138:../../CM4/Core/Src/main.c ****     }
 139:../../CM4/Core/Src/main.c ****     HAL_Delay(500U);
 140:../../CM4/Core/Src/main.c **** 
 141:../../CM4/Core/Src/main.c ****     uint8_t any_echo = 0U;
 142:../../CM4/Core/Src/main.c ****     uint32_t echo_time = 0U;
 143:../../CM4/Core/Src/main.c **** 
 144:../../CM4/Core/Src/main.c ****     for (int attempt = 0; attempt < 10; attempt++) {
 145:../../CM4/Core/Src/main.c ****         /* Trigger */
