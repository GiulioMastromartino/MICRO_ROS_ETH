  17:../../CM4/Core/Src/main.c **** 
  18:../../CM4/Core/Src/main.c **** #define TIMER_TARGET_HZ       1000000U
  19:../../CM4/Core/Src/main.c **** #define TRIG_RESET_TIME_US    2U
  20:../../CM4/Core/Src/main.c **** #define TRIG_PULSE_TIME_US    10U
  21:../../CM4/Core/Src/main.c **** #define ECHO_WAIT_TIMEOUT_US  60000U
