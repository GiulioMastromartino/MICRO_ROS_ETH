 148:../../CM4/Core/Src/main.c ****         while (__HAL_TIM_GET_COUNTER(&htim2) < TRIG_RESET_TIME_US);
 149:../../CM4/Core/Src/main.c **** 
 150:../../CM4/Core/Src/main.c ****         HAL_GPIO_WritePin(GPIOD, GPIO_PIN_1, GPIO_PIN_SET);
 151:../../CM4/Core/Src/main.c ****         __HAL_TIM_SET_COUNTER(&htim2, 0);
 152:../../CM4/Core/Src/main.c ****         while (__HAL_TIM_GET_COUNTER(&htim2) < TRIG_PULSE_TIME_US);
 153:../../CM4/Core/Src/main.c ****         HAL_GPIO_WritePin(GPIOD, GPIO_PIN_1, GPIO_PIN_RESET);
 154:../../CM4/Core/Src/main.c **** 
 155:../../CM4/Core/Src/main.c ****         /* Wait for echo HIGH */
 156:../../CM4/Core/Src/main.c ****         uint8_t got_echo = 0U;
 157:../../CM4/Core/Src/main.c ****         uint32_t wait_start = __HAL_TIM_GET_COUNTER(&htim2);
 158:../../CM4/Core/Src/main.c ****         while (HAL_GPIO_ReadPin(GPIOD, GPIO_PIN_0) == GPIO_PIN_RESET) {
 159:../../CM4/Core/Src/main.c ****             if ((uint32_t)(__HAL_TIM_GET_COUNTER(&htim2) - wait_start)
 160:../../CM4/Core/Src/main.c ****                     > ECHO_WAIT_TIMEOUT_US) { break; }
 161:../../CM4/Core/Src/main.c ****         }
 162:../../CM4/Core/Src/main.c **** 
 163:../../CM4/Core/Src/main.c ****         if (HAL_GPIO_ReadPin(GPIOD, GPIO_PIN_0) == GPIO_PIN_SET) {
 164:../../CM4/Core/Src/main.c ****             uint32_t echo_start = __HAL_TIM_GET_COUNTER(&htim2);
 165:../../CM4/Core/Src/main.c ****             while (HAL_GPIO_ReadPin(GPIOD, GPIO_PIN_0) == GPIO_PIN_SET) {
 166:../../CM4/Core/Src/main.c ****                 if ((uint32_t)(__HAL_TIM_GET_COUNTER(&htim2) - echo_start)
 167:../../CM4/Core/Src/main.c ****                         > ECHO_PULSE_TIMEOUT_US) { break; }
 168:../../CM4/Core/Src/main.c ****             }
 169:../../CM4/Core/Src/main.c ****             echo_time = (uint32_t)(__HAL_TIM_GET_COUNTER(&htim2) - echo_start);
 170:../../CM4/Core/Src/main.c ****             got_echo = 1U;
 171:../../CM4/Core/Src/main.c ****             any_echo = 1U;
 172:../../CM4/Core/Src/main.c ****         }
 173:../../CM4/Core/Src/main.c **** 
 174:../../CM4/Core/Src/main.c ****         if (got_echo) {
 175:../../CM4/Core/Src/main.c ****             /* GREEN blink = echo received this attempt */
 176:../../CM4/Core/Src/main.c ****             LED_GREEN_ON(); HAL_Delay(300U); LED_GREEN_OFF();
 177:../../CM4/Core/Src/main.c ****         } else {
 178:../../CM4/Core/Src/main.c ****             /* RED blink = no echo this attempt */
 179:../../CM4/Core/Src/main.c ****             LED_RED_ON(); HAL_Delay(300U); LED_RED_OFF();
 180:../../CM4/Core/Src/main.c ****         }
 181:../../CM4/Core/Src/main.c ****         HAL_Delay(200U);
 182:../../CM4/Core/Src/main.c ****     }
 183:../../CM4/Core/Src/main.c ****     HAL_Delay(1000U);
 184:../../CM4/Core/Src/main.c **** 
 185:../../CM4/Core/Src/main.c **** 
 186:../../CM4/Core/Src/main.c ****     /* ================================================================== */
 187:../../CM4/Core/Src/main.c ****     /* PHASE 4: Result                                                     */
 188:../../CM4/Core/Src/main.c ****     /* If any echo was received: distance blinks on green                 */
 189:../../CM4/Core/Src/main.c ****     /* If no echo at all:        solid red forever → debug wiring         */
 190:../../CM4/Core/Src/main.c ****     /* ================================================================== */
 191:../../CM4/Core/Src/main.c ****     if (!any_echo) {
 192:../../CM4/Core/Src/main.c ****         /* Solid red = complete failure, check wiring */
 193:../../CM4/Core/Src/main.c ****         LED_RED_ON();
 194:../../CM4/Core/Src/main.c ****         while (1);
 195:../../CM4/Core/Src/main.c ****     }
 196:../../CM4/Core/Src/main.c **** 
 197:../../CM4/Core/Src/main.c ****     /* Distance in cm via green blinks (up to 9, then pause) */
 198:../../CM4/Core/Src/main.c ****     uint32_t dist_cm = echo_time / 58U;
 199:../../CM4/Core/Src/main.c ****     while (1) {
 200:../../CM4/Core/Src/main.c ****         uint32_t blinks = dist_cm;
 201:../../CM4/Core/Src/main.c ****         if (blinks == 0U)  { blinks = 1U; }
 202:../../CM4/Core/Src/main.c ****         if (blinks > 20U)  { blinks = 20U; }
 203:../../CM4/Core/Src/main.c **** 
 204:../../CM4/Core/Src/main.c ****         for (uint32_t b = 0; b < blinks; b++) {
