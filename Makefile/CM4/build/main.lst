  72:../../CM4/Core/Src/main.c **** 
  73:../../CM4/Core/Src/main.c ****     /* Clocks OK — 2 green blinks */
  74:../../CM4/Core/Src/main.c ****     for (int j = 0; j < 2; j++) {
  75:../../CM4/Core/Src/main.c ****         LED_GREEN_ON(); HAL_Delay(200U);
  76:../../CM4/Core/Src/main.c ****         LED_GREEN_OFF(); HAL_Delay(200U);
  77:../../CM4/Core/Src/main.c ****     }
  78:../../CM4/Core/Src/main.c ****     HAL_Delay(500U);
