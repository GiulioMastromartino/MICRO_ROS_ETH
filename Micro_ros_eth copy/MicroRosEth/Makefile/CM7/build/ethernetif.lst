 365:../../CM7/LWIP/Target/ethernetif.c **** /**
 366:../../CM7/LWIP/Target/ethernetif.c ****  * @brief This function should do the actual transmission of the packet. The packet is
 367:../../CM7/LWIP/Target/ethernetif.c ****  * contained in the pbuf that is passed to the function. This pbuf
 368:../../CM7/LWIP/Target/ethernetif.c ****  * might be chained.
 369:../../CM7/LWIP/Target/ethernetif.c ****  *
 370:../../CM7/LWIP/Target/ethernetif.c ****  * @param netif the lwip network interface structure for this ethernetif
 371:../../CM7/LWIP/Target/ethernetif.c ****  * @param p the MAC packet to send (e.g. IP packet including MAC addresses and type)
 372:../../CM7/LWIP/Target/ethernetif.c ****  * @return ERR_OK if the packet could be sent
 373:../../CM7/LWIP/Target/ethernetif.c ****  *         an err_t value if the packet couldn't be sent
 374:../../CM7/LWIP/Target/ethernetif.c ****  *
ARM GAS  /var/folders/2r/mdtt8xvd351gdc398t28_m2m0000gn/T//cc88wwb0.s 			page 8


 375:../../CM7/LWIP/Target/ethernetif.c ****  * @note Returning ERR_MEM here if a DMA queue of your MAC is full can lead to
 376:../../CM7/LWIP/Target/ethernetif.c ****  *       strange results. You might consider waiting for space in the DMA queue
 377:../../CM7/LWIP/Target/ethernetif.c ****  *       to become available since the stack doesn't retry to send a packet
 378:../../CM7/LWIP/Target/ethernetif.c ****  *       dropped because of memory failure (except for the TCP timers).
 379:../../CM7/LWIP/Target/ethernetif.c ****  */
 380:../../CM7/LWIP/Target/ethernetif.c **** 
 381:../../CM7/LWIP/Target/ethernetif.c **** static err_t low_level_output(struct netif *netif, struct pbuf *p)
 382:../../CM7/LWIP/Target/ethernetif.c **** {
 383:../../CM7/LWIP/Target/ethernetif.c ****   uint32_t i = 0U;
 384:../../CM7/LWIP/Target/ethernetif.c ****   struct pbuf *q = NULL;
 385:../../CM7/LWIP/Target/ethernetif.c ****   err_t errval = ERR_OK;
 386:../../CM7/LWIP/Target/ethernetif.c ****   ETH_BufferTypeDef Txbuffer[ETH_TX_DESC_CNT] = {0};
 387:../../CM7/LWIP/Target/ethernetif.c **** 
 388:../../CM7/LWIP/Target/ethernetif.c ****   memset(Txbuffer, 0 , ETH_TX_DESC_CNT*sizeof(ETH_BufferTypeDef));
 389:../../CM7/LWIP/Target/ethernetif.c **** 
 390:../../CM7/LWIP/Target/ethernetif.c ****   for(q = p; q != NULL; q = q->next)
 391:../../CM7/LWIP/Target/ethernetif.c ****   {
 392:../../CM7/LWIP/Target/ethernetif.c ****     if(i >= ETH_TX_DESC_CNT)
 393:../../CM7/LWIP/Target/ethernetif.c ****       return ERR_IF;
 394:../../CM7/LWIP/Target/ethernetif.c **** 
 395:../../CM7/LWIP/Target/ethernetif.c ****     Txbuffer[i].buffer = q->payload;
 396:../../CM7/LWIP/Target/ethernetif.c ****     Txbuffer[i].len = q->len;
 397:../../CM7/LWIP/Target/ethernetif.c **** 
 398:../../CM7/LWIP/Target/ethernetif.c ****     if(i>0)
 399:../../CM7/LWIP/Target/ethernetif.c ****     {
 400:../../CM7/LWIP/Target/ethernetif.c ****       Txbuffer[i-1].next = &Txbuffer[i];
 401:../../CM7/LWIP/Target/ethernetif.c ****     }
 402:../../CM7/LWIP/Target/ethernetif.c **** 
 403:../../CM7/LWIP/Target/ethernetif.c ****     if(q->next == NULL)
 404:../../CM7/LWIP/Target/ethernetif.c ****     {
 405:../../CM7/LWIP/Target/ethernetif.c ****       Txbuffer[i].next = NULL;
 406:../../CM7/LWIP/Target/ethernetif.c ****     }
 407:../../CM7/LWIP/Target/ethernetif.c **** 
 408:../../CM7/LWIP/Target/ethernetif.c ****     i++;
 409:../../CM7/LWIP/Target/ethernetif.c ****   }
 410:../../CM7/LWIP/Target/ethernetif.c **** 
 411:../../CM7/LWIP/Target/ethernetif.c ****   TxConfig.Length = p->tot_len;
 412:../../CM7/LWIP/Target/ethernetif.c ****   TxConfig.TxBuffer = Txbuffer;
 413:../../CM7/LWIP/Target/ethernetif.c ****   TxConfig.pData = p;
 414:../../CM7/LWIP/Target/ethernetif.c **** 
 415:../../CM7/LWIP/Target/ethernetif.c ****   pbuf_ref(p);
 416:../../CM7/LWIP/Target/ethernetif.c **** 
 417:../../CM7/LWIP/Target/ethernetif.c ****   do
 418:../../CM7/LWIP/Target/ethernetif.c ****   {
 419:../../CM7/LWIP/Target/ethernetif.c ****     if(HAL_ETH_Transmit_IT(&heth, &TxConfig) == HAL_OK)
 420:../../CM7/LWIP/Target/ethernetif.c ****     {
 421:../../CM7/LWIP/Target/ethernetif.c ****       errval = ERR_OK;
 422:../../CM7/LWIP/Target/ethernetif.c ****     }
 423:../../CM7/LWIP/Target/ethernetif.c ****     else
 424:../../CM7/LWIP/Target/ethernetif.c ****     {
 425:../../CM7/LWIP/Target/ethernetif.c **** 
 426:../../CM7/LWIP/Target/ethernetif.c ****       if(HAL_ETH_GetError(&heth) & HAL_ETH_ERROR_BUSY)
 427:../../CM7/LWIP/Target/ethernetif.c ****       {
 428:../../CM7/LWIP/Target/ethernetif.c ****         /* Wait for descriptors to become available */
 429:../../CM7/LWIP/Target/ethernetif.c ****         osSemaphoreAcquire(TxPktSemaphore, ETHIF_TX_TIMEOUT);
 430:../../CM7/LWIP/Target/ethernetif.c ****         HAL_ETH_ReleaseTxPacket(&heth);
 431:../../CM7/LWIP/Target/ethernetif.c ****         errval = ERR_BUF;
ARM GAS  /var/folders/2r/mdtt8xvd351gdc398t28_m2m0000gn/T//cc88wwb0.s 			page 9


 432:../../CM7/LWIP/Target/ethernetif.c ****       }
 433:../../CM7/LWIP/Target/ethernetif.c ****       else
 434:../../CM7/LWIP/Target/ethernetif.c ****       {
 435:../../CM7/LWIP/Target/ethernetif.c ****         /* Other error */
 436:../../CM7/LWIP/Target/ethernetif.c ****         pbuf_free(p);
 437:../../CM7/LWIP/Target/ethernetif.c ****         errval =  ERR_IF;
 438:../../CM7/LWIP/Target/ethernetif.c ****       }
 439:../../CM7/LWIP/Target/ethernetif.c ****     }
 440:../../CM7/LWIP/Target/ethernetif.c ****   }while(errval == ERR_BUF);
 441:../../CM7/LWIP/Target/ethernetif.c **** 
 442:../../CM7/LWIP/Target/ethernetif.c ****   return errval;
 443:../../CM7/LWIP/Target/ethernetif.c **** }
