 806:../../Middlewares/Third_Party/LwIP/src/api/api_lib.c ****              NETCONNTYPE_GROUP(netconn_type(conn)) == NETCONN_TCP, return ERR_ARG;);
 807:../../Middlewares/Third_Party/LwIP/src/api/api_lib.c **** 
