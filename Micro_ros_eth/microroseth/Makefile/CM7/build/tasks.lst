4771:../../Middlewares/Third_Party/FreeRTOS/Source/tasks.c **** 			pxCurrentTCB->ucNotifyState = taskNOT_WAITING_NOTIFICATION;
4772:../../Middlewares/Third_Party/FreeRTOS/Source/tasks.c **** 		}
