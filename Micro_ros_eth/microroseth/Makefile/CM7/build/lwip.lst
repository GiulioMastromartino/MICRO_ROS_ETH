  90:../../CM7/LWIP/App/lwip.c ****   /* Initialize the LwIP stack with RTOS */
  91:../../CM7/LWIP/App/lwip.c ****   tcpip_init( NULL, NULL );
  92:../../CM7/LWIP/App/lwip.c **** 
  93:../../CM7/LWIP/App/lwip.c ****   /* IP addresses initialization without DHCP (IPv4) */
  94:../../CM7/LWIP/App/lwip.c ****   IP4_ADDR(&ipaddr, IP_ADDRESS[0], IP_ADDRESS[1], IP_ADDRESS[2], IP_ADDRESS[3]);
  95:../../CM7/LWIP/App/lwip.c ****   IP4_ADDR(&netmask, NETMASK_ADDRESS[0], NETMASK_ADDRESS[1] , NETMASK_ADDRESS[2], NETMASK_ADDRESS[3
