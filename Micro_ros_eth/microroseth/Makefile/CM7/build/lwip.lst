  61:../../CM7/LWIP/App/lwip.c ****   * LwIP initialization function
  62:../../CM7/LWIP/App/lwip.c ****   */
  63:../../CM7/LWIP/App/lwip.c **** void MX_LWIP_Init(void)
  64:../../CM7/LWIP/App/lwip.c **** {
  65:../../CM7/LWIP/App/lwip.c ****   /* IP addresses initialization */
  66:../../CM7/LWIP/App/lwip.c ****   // Change from 192.168.1.x to 172.20.10.x subnet
  67:../../CM7/LWIP/App/lwip.c **** 
  68:../../CM7/LWIP/App/lwip.c ****   // STM32 IP Address (choose any free IP on the 172.20.10.x network)
  69:../../CM7/LWIP/App/lwip.c ****   IP_ADDRESS[0] = 172;
  70:../../CM7/LWIP/App/lwip.c ****   IP_ADDRESS[1] = 20;
  71:../../CM7/LWIP/App/lwip.c ****   IP_ADDRESS[2] = 10;
  72:../../CM7/LWIP/App/lwip.c ****   IP_ADDRESS[3] = 10;  // ← STM32's IP (not .12 which is Raspberry Pi)
  73:../../CM7/LWIP/App/lwip.c **** 
  74:../../CM7/LWIP/App/lwip.c ****   // Subnet Mask (stays the same)
  75:../../CM7/LWIP/App/lwip.c ****   NETMASK_ADDRESS[0] = 255;
  76:../../CM7/LWIP/App/lwip.c ****   NETMASK_ADDRESS[1] = 255;
  77:../../CM7/LWIP/App/lwip.c ****   NETMASK_ADDRESS[2] = 255;
  78:../../CM7/LWIP/App/lwip.c ****   NETMASK_ADDRESS[3] = 240;
  79:../../CM7/LWIP/App/lwip.c **** 
  80:../../CM7/LWIP/App/lwip.c ****   // Gateway Address (your router/hotspot)
  81:../../CM7/LWIP/App/lwip.c ****   GATEWAY_ADDRESS[0] = 172;
  82:../../CM7/LWIP/App/lwip.c ****   GATEWAY_ADDRESS[1] = 20;
  83:../../CM7/LWIP/App/lwip.c ****   GATEWAY_ADDRESS[2] = 10;
  84:../../CM7/LWIP/App/lwip.c ****   GATEWAY_ADDRESS[3] = 13;  // ← Usually .1 is the gateway
  85:../../CM7/LWIP/App/lwip.c **** 
  86:../../CM7/LWIP/App/lwip.c **** 
  87:../../CM7/LWIP/App/lwip.c **** /* USER CODE BEGIN IP_ADDRESSES */
  88:../../CM7/LWIP/App/lwip.c **** /* USER CODE END IP_ADDRESSES */
