  97:../../CM7/LWIP/App/lwip.c **** 
  98:../../CM7/LWIP/App/lwip.c ****   /* add the network interface (IPv4/IPv6) with RTOS */
  99:../../CM7/LWIP/App/lwip.c ****   netif_add(&gnetif, &ipaddr, &netmask, &gw, NULL, &ethernetif_init, &tcpip_input);
 100:../../CM7/LWIP/App/lwip.c **** 
 101:../../CM7/LWIP/App/lwip.c ****   /* Registers the default network interface */
 102:../../CM7/LWIP/App/lwip.c ****   netif_set_default(&gnetif);
 103:../../CM7/LWIP/App/lwip.c **** 
 104:../../CM7/LWIP/App/lwip.c ****   /* We must always bring the network interface up connection or not... */
 105:../../CM7/LWIP/App/lwip.c ****   netif_set_up(&gnetif);
 106:../../CM7/LWIP/App/lwip.c **** 
 107:../../CM7/LWIP/App/lwip.c ****   /* Set the link callback function, this function is called on change of link status*/
 108:../../CM7/LWIP/App/lwip.c ****   netif_set_link_callback(&gnetif, ethernet_link_status_updated);
 109:../../CM7/LWIP/App/lwip.c **** 
 110:../../CM7/LWIP/App/lwip.c ****   /* Create the Ethernet link handler thread */
 111:../../CM7/LWIP/App/lwip.c **** /* USER CODE BEGIN H7_OS_THREAD_NEW_CMSIS_RTOS_V2 */
 112:../../CM7/LWIP/App/lwip.c ****   memset(&attributes, 0x0, sizeof(osThreadAttr_t));
 113:../../CM7/LWIP/App/lwip.c ****   attributes.name = "EthLink";
 114:../../CM7/LWIP/App/lwip.c ****   attributes.stack_size = INTERFACE_THREAD_STACK_SIZE;
 115:../../CM7/LWIP/App/lwip.c ****   attributes.priority = osPriorityBelowNormal;
 116:../../CM7/LWIP/App/lwip.c ****   osThreadNew(ethernet_link_thread, &gnetif, &attributes);
