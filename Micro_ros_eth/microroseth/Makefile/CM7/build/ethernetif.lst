 489:../../CM7/LWIP/Target/ethernetif.c **** /**
 490:../../CM7/LWIP/Target/ethernetif.c ****  * @brief Should allocate a pbuf and transfer the bytes of the incoming
 491:../../CM7/LWIP/Target/ethernetif.c ****  * packet from the interface into the pbuf.
 492:../../CM7/LWIP/Target/ethernetif.c ****  *
 493:../../CM7/LWIP/Target/ethernetif.c ****  * @param netif the lwip network interface structure for this ethernetif
 494:../../CM7/LWIP/Target/ethernetif.c ****  * @return a pbuf filled with the received packet (including MAC header)
 495:../../CM7/LWIP/Target/ethernetif.c ****  *         NULL on memory error
 496:../../CM7/LWIP/Target/ethernetif.c ****    */
 497:../../CM7/LWIP/Target/ethernetif.c **** static struct pbuf * low_level_input(struct netif *netif)
 498:../../CM7/LWIP/Target/ethernetif.c **** {
 499:../../CM7/LWIP/Target/ethernetif.c ****   struct pbuf *p = NULL;
 500:../../CM7/LWIP/Target/ethernetif.c **** 
 501:../../CM7/LWIP/Target/ethernetif.c ****   if(RxAllocStatus == RX_ALLOC_OK)
 502:../../CM7/LWIP/Target/ethernetif.c ****   {
 503:../../CM7/LWIP/Target/ethernetif.c ****     HAL_ETH_ReadData(&heth, (void **)&p);
 504:../../CM7/LWIP/Target/ethernetif.c ****   }
 505:../../CM7/LWIP/Target/ethernetif.c **** 
 506:../../CM7/LWIP/Target/ethernetif.c ****   return p;
 507:../../CM7/LWIP/Target/ethernetif.c **** }
 508:../../CM7/LWIP/Target/ethernetif.c **** 
 509:../../CM7/LWIP/Target/ethernetif.c **** /**
 510:../../CM7/LWIP/Target/ethernetif.c ****  * @brief This function should be called when a packet is ready to be read
 511:../../CM7/LWIP/Target/ethernetif.c ****  * from the interface. It uses the function low_level_input() that
 512:../../CM7/LWIP/Target/ethernetif.c ****  * should handle the actual reception of bytes from the network
 513:../../CM7/LWIP/Target/ethernetif.c ****  * interface. Then the type of the received packet is determined and
 514:../../CM7/LWIP/Target/ethernetif.c ****  * the appropriate input function is called.
 515:../../CM7/LWIP/Target/ethernetif.c ****  *
 516:../../CM7/LWIP/Target/ethernetif.c ****  * @param netif the lwip network interface structure for this ethernetif
 517:../../CM7/LWIP/Target/ethernetif.c ****  */
 518:../../CM7/LWIP/Target/ethernetif.c **** void ethernetif_input(void* argument)
 519:../../CM7/LWIP/Target/ethernetif.c **** {
 520:../../CM7/LWIP/Target/ethernetif.c ****   struct pbuf *p = NULL;
 521:../../CM7/LWIP/Target/ethernetif.c ****   struct netif *netif = (struct netif *) argument;
 522:../../CM7/LWIP/Target/ethernetif.c **** 
 523:../../CM7/LWIP/Target/ethernetif.c ****   for( ;; )
 524:../../CM7/LWIP/Target/ethernetif.c ****   {
 525:../../CM7/LWIP/Target/ethernetif.c ****     if (osSemaphoreAcquire(RxPktSemaphore, TIME_WAITING_FOR_INPUT) == osOK)
 526:../../CM7/LWIP/Target/ethernetif.c ****     {
 527:../../CM7/LWIP/Target/ethernetif.c ****       do
 528:../../CM7/LWIP/Target/ethernetif.c ****       {
 529:../../CM7/LWIP/Target/ethernetif.c ****         p = low_level_input( netif );
 530:../../CM7/LWIP/Target/ethernetif.c ****         if (p != NULL)
 531:../../CM7/LWIP/Target/ethernetif.c ****         {
 532:../../CM7/LWIP/Target/ethernetif.c ****           if (netif->input( p, netif) != ERR_OK )
 533:../../CM7/LWIP/Target/ethernetif.c ****           {
 534:../../CM7/LWIP/Target/ethernetif.c ****             pbuf_free(p);
 535:../../CM7/LWIP/Target/ethernetif.c ****           }
 536:../../CM7/LWIP/Target/ethernetif.c ****         }
 537:../../CM7/LWIP/Target/ethernetif.c ****       } while(p!=NULL);
 538:../../CM7/LWIP/Target/ethernetif.c ****     }
 539:../../CM7/LWIP/Target/ethernetif.c ****   }
 540:../../CM7/LWIP/Target/ethernetif.c **** }
