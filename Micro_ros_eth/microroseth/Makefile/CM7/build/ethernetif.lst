 472:../../CM7/LWIP/Target/ethernetif.c ****   if(RxAllocStatus == RX_ALLOC_OK)
 473:../../CM7/LWIP/Target/ethernetif.c ****   {
 474:../../CM7/LWIP/Target/ethernetif.c ****     HAL_ETH_ReadData(&heth, (void **)&p);
 475:../../CM7/LWIP/Target/ethernetif.c ****   }
 476:../../CM7/LWIP/Target/ethernetif.c **** 
 477:../../CM7/LWIP/Target/ethernetif.c ****   return p;
 478:../../CM7/LWIP/Target/ethernetif.c **** }
 479:../../CM7/LWIP/Target/ethernetif.c **** 
 480:../../CM7/LWIP/Target/ethernetif.c **** /**
 481:../../CM7/LWIP/Target/ethernetif.c ****  * @brief This function should be called when a packet is ready to be read
 482:../../CM7/LWIP/Target/ethernetif.c ****  * from the interface. It uses the function low_level_input() that
 483:../../CM7/LWIP/Target/ethernetif.c ****  * should handle the actual reception of bytes from the network
 484:../../CM7/LWIP/Target/ethernetif.c ****  * interface. Then the type of the received packet is determined and
 485:../../CM7/LWIP/Target/ethernetif.c ****  * the appropriate input function is called.
 486:../../CM7/LWIP/Target/ethernetif.c ****  *
 487:../../CM7/LWIP/Target/ethernetif.c ****  * @param netif the lwip network interface structure for this ethernetif
 488:../../CM7/LWIP/Target/ethernetif.c ****  */
ARM GAS  /var/folders/2r/mdtt8xvd351gdc398t28_m2m0000gn/T//cc7M34vh.s 			page 10


 489:../../CM7/LWIP/Target/ethernetif.c **** void ethernetif_input(void* argument)
 490:../../CM7/LWIP/Target/ethernetif.c **** {
 491:../../CM7/LWIP/Target/ethernetif.c ****   struct pbuf *p = NULL;
 492:../../CM7/LWIP/Target/ethernetif.c ****   struct netif *netif = (struct netif *) argument;
 493:../../CM7/LWIP/Target/ethernetif.c **** 
 494:../../CM7/LWIP/Target/ethernetif.c ****   for( ;; )
 495:../../CM7/LWIP/Target/ethernetif.c ****   {
 496:../../CM7/LWIP/Target/ethernetif.c ****     if (osSemaphoreAcquire(RxPktSemaphore, TIME_WAITING_FOR_INPUT) == osOK)
 497:../../CM7/LWIP/Target/ethernetif.c ****     {
 498:../../CM7/LWIP/Target/ethernetif.c ****       do
 499:../../CM7/LWIP/Target/ethernetif.c ****       {
 500:../../CM7/LWIP/Target/ethernetif.c ****         p = low_level_input( netif );
 501:../../CM7/LWIP/Target/ethernetif.c ****         if (p != NULL)
 502:../../CM7/LWIP/Target/ethernetif.c ****         {
 503:../../CM7/LWIP/Target/ethernetif.c ****           if (netif->input( p, netif) != ERR_OK )
 504:../../CM7/LWIP/Target/ethernetif.c ****           {
 505:../../CM7/LWIP/Target/ethernetif.c ****             pbuf_free(p);
 506:../../CM7/LWIP/Target/ethernetif.c ****           }
 507:../../CM7/LWIP/Target/ethernetif.c ****         }
 508:../../CM7/LWIP/Target/ethernetif.c ****       } while(p!=NULL);
 509:../../CM7/LWIP/Target/ethernetif.c ****     }
 510:../../CM7/LWIP/Target/ethernetif.c ****   }
 511:../../CM7/LWIP/Target/ethernetif.c **** }
